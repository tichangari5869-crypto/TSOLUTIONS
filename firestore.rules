rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSiteAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.uid == "REPLACE_WITH_ADMIN_UID";
    }

    match /site/catalog {
      allow read: if true;
      allow create, update: if isSiteAdmin()
        && request.resource.data.keys().hasOnly(["categories", "settings"])
        && request.resource.data.categories is list
        && request.resource.data.settings is map;
      allow delete: if false;
    }
  }
}
